{
  "name": "terraforming-mars",
  "version": "1.0.0",
  "description": "Terraforming Mars Game",
  "engines": {
    "node": ">=16.x <=22.x"
  },
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@hono/node-server": "^1.19.9",
    "@types/chai-as-promised": "^7.1.5",
    "@types/mocha": "^10.0.0",
    "chai-as-promised": "^7.1.1",
    "chai-deep-equal-ignore-undefined": "^1.1.1",
    "chart.js": "^4.4.7",
    "console-stamp": "3.1.2",
    "cross-env": "^7.0.3",
    "dialog-polyfill": "^0.5.1",
    "dotenv": "^8.2.0",
    "eslint": "^8.26.0",
    "hono": "^4.11.9",
    "html-escaper": "^3.0.3",
    "mnemonist": "^0.39.3",
    "mocha": "^10.1.0",
    "prom-client": "^14.1.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.1",
    "ts-trueskill": "^3.2.2",
    "uuid": "^11.0.5",
    "vti": "^0.1.8",
    "vue": "2.7.16",
    "vue-tailwind": "^2.5.1",
    "vue-typed-refs": "^1.0.0"
  },
  "devDependencies": {
    "@types/ansi-escape-sequences": "^4.0.4",
    "@types/chai": "^4.3.1",
    "@types/chai-as-promised": "^7.1.5",
    "@types/html-escaper": "^3.0.0",
    "@types/mocha": "^9.1.1",
    "@types/node": "^22.19.10",
    "@types/pg": "^7.14.7",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.30.7",
    "@typescript-eslint/parser": "^5.30.7",
    "@vitejs/plugin-vue2": "^2.3.1",
    "@vue/test-utils": "^1.3.6",
    "autoprefixer": "^10.4.13",
    "axios": "^0.21.1",
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "chai-deep-equal-ignore-undefined": "^1.1.1",
    "eslint": "^8.20.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-vue": "^9.2.0",
    "jsdom": "^22.1.0",
    "less": "^4.5.1",
    "mocha": "^9.2.2",
    "playwright": "^1.58.2",
    "postcss": "^8.4.21",
    "rimraf": "^3.0.2",
    "spectre.css": "^0.5.8",
    "tailwindcss": "^3.2.7",
    "ts-mocha": "^9.0.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^3.11.0",
    "typescript": "^5.3.3",
    "vite": "^5",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^1",
    "vue-template-compiler": "2.7.16",
    "vue-typed-refs": "^1.0.0",
    "zlib": "^1.0.5"
  },
  "optionalDependencies": {
    "pg": "^8.2.1",
    "sqlite3": "^5.1.7"
  },
  "scripts": {
    "start": "node build/src/server/server.js",
    "starttest": "node build/src/server/server_test.js",
    "start:prof": "node --prof build/src/server/server.js",
    "build": "npm run make:static && npm run build:server && npm run build:client",
    "build:client": "npm run make:cards && vite build",
    "build:clientAll": "npm run make:cards && npm run test:client:HTML && vite build",
    "build:server": "tsc --build src/tsconfig.json",
    "build:tests": "tsc --build tests/tsconfig.json",
    "lint": "npm run lint:server && npm run lint:i18n && npm run lint:client",
    "lint:client": "vti diagnostics",
    "lint:server": "eslint --cache src tests --ext ts --ext vue",
    "lint:fix": "eslint --fix src tests --ext ts --ext vue",
    "lint:i18n": "ts-node src/tools/translation_audit.ts",
    "make:css": "lessc src/styles/common.less build/styles.css & tailwindcss -i ./src/styles/tailwindcss.css -o ./build/tailwindcss.css & wait",
    "watch:css": "node scripts/watchcss.js src/styles",
    "make:cards": "ts-node src/server/tools/export_card_rendering.ts",
    "make:json": "ts-node src/tools/make_static_json.ts",
    "make:static": "npm run make:css & npm run make:json & wait",
    "test": "npm run test:server && npm run test:client",
    "test:server": "NODE_OPTIONS='--no-experimental-strip-types' ts-mocha -p tests/tsconfig.json --reporter-option maxDiffSize=256 -r tests/testing/setup.ts 'tests/*.spec.ts' \"tests/!(client|integration)/**/*.spec.ts\"",
    "test:one": "ts-mocha  --timeout 1000000 -p tests/tsconfig.json --reporter-option maxDiffSize=256  -r tests/testing/setup.ts  \"tests/cards/**/*.spec.ts\" ",
    "test:integration": "ts-mocha --no-timeouts -p tests/tsconfig.json \"tests/integration/**/*.spec.ts\"",
    "test:new": "ts-mocha -p tests/tsconfig.json -r tests/testing/setup.ts \"tests/hono/**/*.spec.ts\" \"tests/rank/**/*.spec.ts\"",
    "test:postgresql": "ts-mocha -p tests/tsconfig.json \"tests/integration/PostgreSQL.spec.ts\"",
    "test:client": "vitest run --config vitest.config.ts",
    "test:client:watch": "vitest --config vitest.config.ts",
    "test:client:HTML": "vitest run --config vitest.config.ts tests/client/components/Card_HTML.spec.ts",
    "test:api": "ts-node scripts/test-api.ts",
    "dev:client": "vite",
    "dev:server": "cross-env NODE_ENV=development tsnd src/server/server.ts",
    "tsc-w": "tsc --build -w src/tsconfig.json",
    "tsc-wt": "tsc --build -w src/tsconfig.json  tests/tsconfig.json",
    "build:bun": "bun run make:static:bun && bun run build:server:bun && bun run build:client:bun",
    "build:client:bun": "bun run make:cards:bun && vite build",
    "build:server:bun": "tsc --build src/tsconfig.json",
    "build:tests:bun": "tsc --build tests/tsconfig.json",
    "lint:i18n:bun": "bun run src/tools/translation_audit.ts",
    "make:cards:bun": "bun run src/server/tools/export_card_rendering.ts",
    "make:json:bun": "bun run src/tools/make_static_json.ts",
    "make:static:bun": "bun run make:css & bun run make:json:bun & wait",
    "test:api:bun": "bun scripts/test-api.ts",
    "dev:server:bun": "bun --watch run src/server/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terraforming-mars/terraforming-mars.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/terraforming-mars/terraforming-mars/issues"
  },
  "homepage": "https://github.com/terraforming-mars/terraforming-mars#readme"
}
