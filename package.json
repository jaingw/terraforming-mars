{
  "name": "terraforming-mars",
  "version": "1.0.0",
  "description": "Terraforming Mars Game",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@hono/node-server": "^1.19.14",
    "@types/mocha": "^10.0.0",
    "bun": "^1.3.13",
    "chart.js": "^4.5.1",
    "claude": "^0.1.2",
    "console-stamp": "3.1.2",
    "cross-env": "^10.1.0",
    "dialog-polyfill": "^0.5.6",
    "dotenv": "^17.3.1",
    "eslint": "^8.26.0",
    "hono": "^4.12.14",
    "html-escaper": "^3.0.3",
    "markdown-it": "^14.1.1",
    "mnemonist": "^0.40.4",
    "mocha": "^10.1.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-trueskill": "^3.3.0",
    "uuid": "^14.0.0",
    "vue": "^3.4.0",
    "vue-tailwind": "^2.5.1",
    "vue-typed-refs": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/ansi-escape-sequences": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/html-escaper": "^3.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/pg": "^7.14.7",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vue/test-utils": "^2.0.0",
    "autoprefixer": "^10.5.0",
    "axios": "^0.21.4",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "less": "^4.6.4",
    "mocha": "^11.7.5",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "rimraf": "^6.1.3",
    "spectre.css": "^0.5.8",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.21",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^1",
    "vue-template-compiler": "2.7.16",
    "vue-tsc": "^3.2.9",
    "zlib": "^1.0.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.10.0",
    "pg": "^8.20.0"
  },
  "scripts": {
    "start": "node build/src/server/server.js",
    "starttest": "node build/src/server/server_test.js",
    "build": "pnpm run make:static && pnpm run build:server && pnpm run make:cards && pnpm run build:client",
    "build:client": " vite build",
    "build:server": "tsc --build src/tsconfig.json --sourceMap false && tsc-alias -p src/tsconfig.json",
    "build:tests": "tsc --build tests/tsconfig.json",
    "lint": "pnpm run lint:server && pnpm run lint:i18n && pnpm run lint:client",
    "lint:client": "vue-tsc --noEmit -p tsconfig.vue-tsc.json",
    "lint:server": "eslint --cache src tests",
    "lint:i18n": "npx tsx src/tools/translation_audit.ts",
    "lint:fix": "eslint --fix src tests",
    "make:css": "lessc src/styles/common.less build/styles.css && tailwindcss -i ./src/styles/tailwindcss.css -o ./build/tailwindcss.css",
    "watch:less": "npx tsx scripts/watchcss.ts src/styles",
    "make:cards": "ts-node src/server/tools/export_card_rendering.ts",
    "make:json": "npx tsx src/tools/make_static_json.ts",
    "make:static": "pnpm run make:css && pnpm run make:json",
    "test": "pnpm run test:server && pnpm run test:client",
    "test:server": "mocha --import=tsx --timeout 120000 --require tests/testing/setup.ts \"tests/*.spec.ts\" \"tests/!(client|integration)/**/*.spec.ts\"",
    "test:one": "mocha --import=tsx --timeout 120000 --reporter-option maxDiffSize=256 --require tests/testing/setup.ts \"tests/cards/**/*.spec.ts\"",
    "test:integration": "mocha --import=tsx --timeout 120000 \"tests/integration/**/*.spec.ts\"",
    "test:new": "ts-mocha --timeout 120000 -p tests/tsconfig.json -r tests/testing/setup.ts \"tests/hono/**/*.spec.ts\" \"tests/rank/**/*.spec.ts\"",
    "test:postgresql": "mocha --import=tsx --timeout 120000 \"tests/integration/PostgreSQL.spec.ts\"",
    "test:client": "vitest run --config vitest.config.mts",
    "test:client:watch": "vitest --config vitest.config.mts",
    "test:api": "ts-node scripts/test-api.ts",
    "dev:client": "vite",
    "dev:server": "cross-env NODE_ENV=development tsx watch  src/server/server.ts",
    "tsc-w": "tsc --build -w src/tsconfig.json",
    "tsc-wt": "tsc --build -w src/tsconfig.json  tests/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terraforming-mars/terraforming-mars.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/terraforming-mars/terraforming-mars/issues"
  },
  "homepage": "https://github.com/terraforming-mars/terraforming-mars#readme"
}
